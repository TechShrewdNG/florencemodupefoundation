# Public URL of the site (used for social sharing links).
SITE_URL="https://florencemodupefoundation.com"

# Database — defaults to a local SQLite file. For production use Turso (libsql://…).
DATABASE_URL="file:./data/fmf.db"
DATABASE_AUTH_TOKEN=""

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
SESSION_SECRET=""

# First admin account, created by `npm run db:setup` when no users exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Image uploads: set this to store uploads in Vercel Blob (needed on Vercel).
# Without it, uploads are saved to UPLOAD_DIR on the server's disk.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"

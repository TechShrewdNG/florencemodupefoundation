# Public URL of the site (used for social sharing links).
SITE_URL="https://theflorencemodupefoundation.com"

# Postgres connection string. Create a free database at https://neon.tech
# (or add Neon from the Vercel Marketplace, which sets this for you).
# Tip: use a separate Neon branch for local development.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
SESSION_SECRET=""

# First admin account, created by `npm run db:setup` when no users exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Image uploads: set this to store uploads in Vercel Blob (required on Vercel).
# Without it, uploads are saved to UPLOAD_DIR on the server's disk.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"
